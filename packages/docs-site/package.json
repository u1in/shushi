{
  "name": "@u1in/shushi-docs-site",
  "description": "@u1in/shushi 的 VuePress 文档发布适配层。",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --config vite.test.config.ts",
    "docs:dev": "vuepress dev ../docs --config vuepress.config.ts",
    "docs:build": "npm --prefix ../.. run quality:check && vuepress build ../docs --config vuepress.config.ts"
  },
  "dependencies": {
    "@u1in/shushi-core": "file:../core",
    "@u1in/shushi-docs": "file:../docs",
    "@u1in/shushi-grid": "file:../grid",
    "@u1in/shushi-macro": "file:../macro",
    "@u1in/shushi-renderers": "file:../renderers",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "@vuepress/bundler-vite": "2.0.0-rc.31",
    "@vuepress/theme-default": "2.0.0-rc.137",
    "mermaid": "^11.12.2",
    "sass-embedded": "^1.107.1",
    "vitest": "^5.0.5",
    "vuepress": "2.0.0-rc.31"
  }
}
