{
  "name": "@u1in/shushi-core",
  "description": "竖式计算、竖式布局、宏编译与网格渲染的统一 npm 入口。",
  "author": "u1in <u1in@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/u1in/shushi.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/u1in/shushi/issues"
  },
  "homepage": "https://github.com/u1in/shushi/tree/main/packages/core#readme",
  "keywords": [
    "shushi",
    "vertical-arithmetic",
    "calculator",
    "addition",
    "subtraction",
    "multiplication",
    "division",
    "short-division",
    "typescript"
  ],
  "version": "0.5.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": ["**/*.css"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build && npm run build:types",
    "build:types": "dts-bundle-generator --project tsconfig.json --out-file dist/index.d.ts src/index.ts",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "dts-bundle-generator": "^9.5.1",
    "vite": "latest"
  }
}
