{
  "name": "@u1in/shushi-core",
  "description": "竖式计算、竖式布局、宏编译与网格渲染的统一 npm 入口。",
  "author": "u1in <u1in@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/u1in/shushi.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/u1in/shushi/issues/new"
  },
  "homepage": "https://u1in.github.io/shushi/",
  "keywords": [
    "shushi",
    "vertical-arithmetic",
    "calculator",
    "addition",
    "subtraction",
    "multiplication",
    "division",
    "short-division",
    "typescript"
  ],
  "version": "4.2.2",
  "type": "module",
  "engines": {
    "node": ">=16.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./renderer.css": "./dist/renderer.css",
    "./renderer-without-font.css": "./dist/renderer-without-font.css",
    "./logo.svg": "./dist/logo.svg",
    "./logo-dark.svg": "./dist/logo-dark.svg",
    "./fonts.css": "./dist/fonts.css",
    "./fonts/cmu-serif.css": "./dist/fonts/cmu-serif.css",
    "./fonts/stix-two-math.css": "./dist/fonts/stix-two-math.css",
    "./fonts/noto-sans-math.css": "./dist/fonts/noto-sans-math.css"
  },
  "scripts": {
    "build": "vite build && npm run build:types",
    "build:types": "dts-bundle-generator --project tsconfig.json --out-file dist/index.d.ts src/index.ts",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "dts-bundle-generator": "^9.5.1",
    "vite": "latest"
  }
}
