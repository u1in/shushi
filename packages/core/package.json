{
  "name": "@vertical-arithmetic/core",
  "description": "四则运算计算、竖式布局、宏编译与网格渲染的统一 npm 入口。",
  "author": "u1in <u1in@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/u1in/vertical-arithmetic-project.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/u1in/vertical-arithmetic-project/issues"
  },
  "homepage": "https://github.com/u1in/vertical-arithmetic-project/tree/main/packages/core#readme",
  "keywords": [
    "vertical-arithmetic",
    "calculator",
    "long-division",
    "long-multiplication",
    "typescript"
  ],
  "version": "0.1.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && npm run build:types",
    "build:types": "dts-bundle-generator --project tsconfig.json --out-file dist/index.d.ts src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "dts-bundle-generator": "^9.5.1",
    "vite": "latest"
  }
}
