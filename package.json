{
  "name": "@u1in/shushi",
  "description": "竖式计算器、竖式布局引擎与行列网格渲染的多包工作区。",
  "author": "u1in <u1in@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/u1in/vertical-arithmetic-project.git"
  },
  "bugs": {
    "url": "https://github.com/u1in/vertical-arithmetic-project/issues"
  },
  "homepage": "https://github.com/u1in/vertical-arithmetic-project#readme",
  "keywords": ["vertical-arithmetic", "arithmetic", "long-division", "long-multiplication", "vue", "typescript"],
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "cd packages/web && npm run dev",
    "start": "npm run dev",
    "build": "npm run build:core && cd packages/web && npm run build",
    "build:core": "cd packages/core && npm run build",
    "docs:dev": "npm run build:core && cd packages/docs-site && npm run docs:dev",
    "docs:build": "npm run build:core && cd packages/docs-site && npm run docs:build",
    "preview": "cd packages/web && npm run preview",
    "test": "cd packages/web && npm run test",
    "typecheck": "npm run typecheck:core && cd packages/web && npm run typecheck",
    "typecheck:core": "cd packages/core && npm run typecheck"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "latest",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
