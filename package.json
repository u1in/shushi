{
  "name": "@u1in/shushi",
  "description": "竖式计算器、竖式布局引擎与行列网格渲染的多包工作区。",
  "author": "u1in <u1in@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/u1in/shushi.git"
  },
  "bugs": {
    "url": "https://github.com/u1in/shushi/issues/new"
  },
  "homepage": "https://github.com/u1in/shushi#readme",
  "keywords": [
    "shushi",
    "vertical-arithmetic",
    "arithmetic",
    "addition",
    "subtraction",
    "multiplication",
    "division",
    "short-division",
    "vue",
    "typescript"
  ],
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "cd packages/web && npm run dev",
    "start": "npm run dev",
    "build": "npm run build:core && cd packages/web && npm run build",
    "build:core": "cd packages/core && npm run build",
    "docs:dev": "npm run sync:changelog && npm run build:core && cd packages/docs-site && npm run docs:dev",
    "docs:build": "npm run sync:changelog && npm run build:core && cd packages/docs-site && npm run docs:build",
    "sync:changelog": "node scripts/sync-changelog.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "quality:check": "npm run format:check && npm run lint",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release:check": "npm run typecheck && npm run test && npm run build",
    "release:publish": "npm run release:check && changeset publish",
    "preview": "cd packages/web && npm run preview",
    "test": "npm run test:web && npm run test:docs-site",
    "test:web": "cd packages/web && npm run test",
    "test:docs-site": "cd packages/docs-site && npm run test",
    "typecheck": "npm run typecheck:core && cd packages/web && npm run typecheck",
    "typecheck:core": "cd packages/core && npm run typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "latest",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
